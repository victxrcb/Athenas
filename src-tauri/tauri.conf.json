{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athenas Agent",
  "version": "0.1.4",
  "identifier": "dev.athenas.agent",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Athenas Agent", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "decorations": false, "backgroundColor": "#0b0b0d" }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com" }
  },
  "bundle": { "active": true, "createUpdaterArtifacts": true, "targets": ["msi", "nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] },
  "plugins": { "updater": { "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNEYzQTQxNURBRjE0NTgKUldSWUZLOWRRVHBQazlKUTA5S1I1UjRZWS9rSlNaZVFmWFpSUG9UZTh6YTBHRUoreFRadmdZcHYK", "endpoints": ["https://github.com/victxrcb/Athenas/releases/latest/download/latest.json"], "windows": { "installMode": "passive" } } }
}
