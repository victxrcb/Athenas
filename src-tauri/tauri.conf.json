{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hera Agent",
  "version": "0.1.0",
  "identifier": "dev.hera.agent",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Hera Agent", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "decorations": false, "backgroundColor": "#0b0b0d" }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
